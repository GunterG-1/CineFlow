# Server Configuration
PORT=4000
NODE_ENV=development

# Microservicios URLs
USUARIOS_SERVICE_URL=http://localhost:8081
CARTELERA_SERVICE_URL=http://localhost:8082
CONFITERIA_SERVICE_URL=http://localhost:8083
ENTRADAS_SERVICE_URL=http://localhost:8084
GATEWAY_URL=http://localhost:8080

# JWT Configuration
JWT_SECRET=tu_clave_secreta_super_segura_2024
JWT_EXPIRES_IN=24h

# CORS Configuration
# Se aceptan varios frontends locales para desarrollo.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Logging
LOG_LEVEL=debug

# Database Cache (Redis opcional)
REDIS_URL=redis://localhost:6379
ENABLE_CACHE=false
